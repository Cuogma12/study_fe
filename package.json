{
  "name": "study_fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js",
    "pm2:restart": "npm run build && pm2 restart study-fe",
    "pm2:stop": "pm2 stop study-fe",
    "pm2:log": "pm2 logs study-fe",
    "docker:build": "docker build -t nextjs-study-fe . && docker rm -f frontend-app || true && docker run -d -p 3000:3000 --name frontend-app --restart unless-stopped nextjs-study-fe",
    "log": "docker logs -f frontend-app"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "js-cookie": "^3.0.5",
    "katex": "^0.17.0",
    "next": "^14.2.3",
    "next-intl": "^4.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "postcss": "^8.4.38",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  }
}
